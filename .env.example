# Postgres 連線字串（從 Supabase 後台 → Project Settings → Database → Session pooler 複製）
# ⚠️ 一定要選「Session pooler」，不是 Direct connection 也不是 Transaction pooler
DATABASE_URI=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Payload 加密金鑰（隨意產一串長字串，建議 32+ 字元）
PAYLOAD_SECRET=replace-this-with-a-long-random-string

# 你的網站對外網址（部署後改成正式 URL）
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase（公開金鑰可給瀏覽器；service role 只能放在伺服器環境變數）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# 官網聯絡表單寄信（Resend）
# onboarding@resend.dev 僅適合測試；正式環境建議改成已驗證的 temo.design 子網域寄件者。
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL="TEMO DESIGN <onboarding@resend.dev>"
CONTACT_TO_EMAIL=temo.design0531@gmail.com
# 用隨機長字串搭配雜湊後的 IP 做防濫用限流；不要使用真實 IP 或公開值。
CONTACT_FORM_RATE_LIMIT_SALT=replace-with-a-long-random-string
